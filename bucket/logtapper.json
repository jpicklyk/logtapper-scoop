  "license": "GPL-3.0-or-later",
  "notes": [
    "LogTapper needs the Microsoft Edge WebView2 Runtime. Windows 11 ships it;",
    "on Windows 10 install it from https://developer.microsoft.com/microsoft-edge/webview2/",
    "Updates come from 'scoop update logtapper'; the in-app updater is disabled for Scoop installs."
  ],
  "url": "https://github.com/jpicklyk/LogTapper/releases/download/v0.14.0/LogTapper_0.14.0_x64-setup.exe",
  "hash": "f29be9cd0c3992c0fba516331d5d5fc4aeb6d6075ded1eb11e9d0a37c3752894",
  "pre_install": [
    "Expand-7zipArchive \"$dir\\$fname\" \"$dir\" -Removal",
    "Remove-Item \"$dir\\`$PLUGINSDIR\" -Recurse -Force -ErrorAction SilentlyContinue"
  ],
  "bin": [["log-tapper.exe", "logtapper"]],
  "shortcuts": [["log-tapper.exe", "LogTapper"]],
  "checkver": "github",
  "autoupdate": {
